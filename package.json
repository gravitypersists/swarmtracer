{
  "name": "swarmtracer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -- --watch=forever & tsx watch server/src/index.ts",
    "build": "esbuild web/src/main.ts --bundle --format=esm --sourcemap --outfile=web/dist/app.js",
    "start": "npm run build && tsx server/src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "node --import tsx --test web/src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "spike": "bash scripts/spike.sh",
    "check:live": "npm run build && node scripts/check-live.mjs",
    "replay": "tsx scripts/replay.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
